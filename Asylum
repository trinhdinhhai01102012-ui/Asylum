local farmRunning = false

-- Hàm hỗ trợ
local function equipPatientTool()
    local char = player.Character
    if not char then return end
    local equippedTool = nil
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") and string.find(string.lower(child.Name), "patient") then
            equippedTool = child
            break
        end
    end
    if not equippedTool then
        local backpack = player:FindFirstChild("Backpack")
        if backpack then
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") and string.find(string.lower(tool.Name), "patient") then
                    if char:FindFirstChild("Humanoid") then
                        char.Humanoid:EquipTool(tool)
                        equippedTool = tool
                        break
                    end
                end
            end
        end
    end
    if equippedTool then pcall(function() equippedTool:Activate() end) end
end

