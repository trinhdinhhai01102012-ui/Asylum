local farmRunning = false

-- Logic Core
getgenv().FarmThread = task.spawn(function()
    while true do
        task.wait(0.5)
        if farmRunning then
            local char = player.Character
            if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
                for _, v in ipairs(workspace:GetDescendants()) do if v:IsA("ProximityPrompt") then v.HoldDuration = 0 end end
                
                local rootPart = char.HumanoidRootPart
                local i = 1
                while farmRunning and i <= #waypoints do
                    StatusLabel.Text = i .. "/" .. #waypoints
                    local target = waypoints[i]
                    
                    -- Luôn luôn dùng Y của nhân vật để không bị kẹt cao độ
                    char.Humanoid:MoveTo(Vector3.new(target.X, rootPart.Position.Y, target.Z))
                    
                    -- Chờ cho đến khi MoveTo hoàn thành (tối đa 5s để tránh kẹt)
                    char.Humanoid.MoveToFinished:Wait(5) 
                    
                    -- Interact
                    for _, v in ipairs(workspace:GetDescendants()) do
                        if v:IsA("ProximityPrompt") and (v.Parent:IsA("BasePart") or v.Parent:IsA("Model")) then
                            local pos = v.Parent:IsA("BasePart") and v.Parent.Position or v.Parent.PrimaryPart.Position
                            if (pos - rootPart.Position).Magnitude <= 7 then pcall(function() fireproximityprompt(v) end) end
                        end
                    end
                    
                    -- Equip Tool
                    local tool = player.Backpack:FindFirstChildOfClass("Tool") or char:FindFirstChildOfClass("Tool")
                    if tool and string.find(string.lower(tool.Name), "patient") then char.Humanoid:EquipTool(tool); tool:Activate() end
                    
                    i = i + 1
                    if i > #waypoints then i = 1 end
                end
            end
        end
    end
end)

ToggleButton.MouseButton1Click:Connect(function()
