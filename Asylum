local farmRunning = false

-- Hàm hỗ trợ
local function equipPatientTool()
    local char = player.Character
    if not char then return end
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and string.find(string.lower(tool.Name), "patient") then
                char.Humanoid:EquipTool(tool)
                pcall(function() tool:Activate() end)
            end
        end
    end
end

-- Vòng lặp chính
getgenv().FarmThread = task.spawn(function()
    while true do
        task.wait(0.5)
        if farmRunning then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                -- Setup Instant
                for _, v in ipairs(workspace:GetDescendants()) do if v:IsA("ProximityPrompt") then v.HoldDuration = 0 end end
                
                local rootPart = char.HumanoidRootPart
                -- Tìm waypoint gần nhất
                local minDistance = math.huge
                local i = 1
                for idx, pos in ipairs(waypoints) do
                    local dist = (Vector2.new(pos.X, pos.Z) - Vector2.new(rootPart.Position.X, rootPart.Position.Z)).Magnitude
                    if dist < minDistance then minDistance = dist; i = idx end
                end
                
                -- Farm
                while farmRunning and i <= #waypoints and player.Character == char do
                    StatusLabel.Text = "Đang đi: " .. i .. "/" .. #waypoints
                    local target = waypoints[i]
                    
                    -- DI CHUYỂN BỎ QUA Y: Chỉ dùng X, Z của target và Y hiện tại
                    char.Humanoid:MoveTo(Vector3.new(target.X, rootPart.Position.Y, target.Z))
                    
                    local startTime = tick()
                    while farmRunning and player.Character == char do
                        local currentPos = rootPart.Position
                        -- Check khoảng cách 2D (XZ)
                        local distXZ = (Vector2.new(currentPos.X, currentPos.Z) - Vector2.new(target.X, target.Z)).Magnitude
                        
                        equipPatientTool()
                        if distXZ <= 0.05 then break end -- Đã tới nơi (sai số cực nhỏ)
                        if tick() - startTime > 10 then break end -- Chống kẹt
                        task.wait(0.1)
                    end
                    
                    -- Interact
                    for _, v in ipairs(workspace:GetDescendants()) do
                        if v:IsA("ProximityPrompt") then
                            local pos = (v.Parent:IsA("BasePart") and v.Parent.Position) or (v.Parent:IsA("Model") and v.Parent.PrimaryPart and v.Parent.PrimaryPart.Position)
                            if pos and (Vector2.new(pos.X, pos.Z) - Vector2.new(rootPart.Position.X, rootPart.Position.Z)).Magnitude <= 7 then 
                                pcall(function() fireproximityprompt(v) end) 
                            end
                        end
                    end
                    
                    i = i + 1
                    if i > #waypoints then i = 1 end
                end
            end
        end
    end
end)

