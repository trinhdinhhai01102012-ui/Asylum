    ToggleButton.Text = farmRunning and "Tắt Farm" or "Bật Farm"
    ToggleButton.BackgroundColor3 = farmRunning and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
end)
