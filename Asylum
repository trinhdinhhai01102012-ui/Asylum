end)

local function triggerInteract(customRadius)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local rootPos = char.HumanoidRootPart.Position
    local radius = customRadius or 5
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            local parentPart = v.Parent
            local promptPos = (parentPart:IsA("BasePart") and parentPart.Position) or (parentPart:IsA("Model") and parentPart.PrimaryPart and parentPart.PrimaryPart.Position)
            if promptPos and (promptPos - rootPos).Magnitude <= radius then
                pcall(function() fireproximityprompt(v) end)
            end
        end
    end
end

-- Vòng lặp chính
task.spawn(function()
    while true do
        task.wait(0.5)
        if farmRunning then
            local char = player.Character
            if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
                setupInstantPrompt()
                local rootPart = char.HumanoidRootPart
                local minDistance = math.huge
                local startIndex = 1
                for i, pos in ipairs(waypoints) do
                    local dist = (pos - rootPart.Position).Magnitude
                    if dist < minDistance then minDistance = dist; startIndex = i end
                end
                local i = startIndex
                while i <= #waypoints and farmRunning and player.Character == char do
                    StatusLabel.Text = "Đang đi tới điểm: " .. i .. "/" .. #waypoints
                    equipPatientTool()
                    local target = waypoints[i]
                    char.Humanoid:MoveTo(target)
                    local startTime = tick()
                    while farmRunning and player.Character == char and (rootPart.Position - Vector3.new(target.X, rootPart.Position.Y, target.Z)).Magnitude > 3 do
                        equipPatientTool()
                        if tick() - startTime > 10 then break end
                        task.wait(0.2)
                    end
                    triggerInteract(5)
                    task.wait(0.1)
                    i = i + 1
                    if i > #waypoints then i = 1 end -- Tự quay lại đầu
                end
            end
        end
    end
end)

