local farmRunning = false

-- Logic Core
getgenv().FarmThread = task.spawn(function()
    while true do
        task.wait(0.5)
        if farmRunning then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local root = char.HumanoidRootPart
                -- Tìm điểm gần nhất
                local minD, i = math.huge, 1
                for idx, pos in pairs(waypoints) do
                    local d = (Vector2.new(pos.X, pos.Z) - Vector2.new(root.Position.X, root.Position.Z)).Magnitude
                    if d < minD then minD = d; i = idx end
                end

                while farmRunning and i <= #waypoints do
                    StatusLabel.Text = i .. "/" .. #waypoints
                    local target = waypoints[i]
                    for _, v in pairs(workspace:GetDescendants()) do if v:IsA("ProximityPrompt") then v.HoldDuration = 0 end end
                    
                    char.Humanoid:MoveTo(Vector3.new(target.X, root.Position.Y, target.Z))
                    local start = tick()
                    while farmRunning and (Vector2.new(root.Position.X, root.Position.Z) - Vector2.new(target.X, target.Z)).Magnitude > 3 do
                        if tick() - start > 5 then break end
                        task.wait(0.2)
                    end
                    
                    for _, v in pairs(workspace:GetDescendants()) do
                        if v:IsA("ProximityPrompt") and v:FindFirstAncestorOfClass("Model") then
                            local pos = v:FindFirstAncestorOfClass("Model"):GetPivot().Position
                            if (Vector2.new(pos.X, pos.Z) - Vector2.new(root.Position.X, root.Position.Z)).Magnitude <= 7 then
                                pcall(function() fireproximityprompt(v) end)
                            end
                        end
                    end
                    
                    local tool = player.Backpack:FindFirstChildOfClass("Tool") or char:FindFirstChildOfClass("Tool")
                    if tool and string.find(string.lower(tool.Name), "patient") then char.Humanoid:EquipTool(tool); tool:Activate() end
                    
                    i = i + 1
                    if i > #waypoints then i = 1 end
                    task.wait(0.1)
                end
            end
        end
    end
end)

